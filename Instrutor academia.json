    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dados de todas as avaliações encontradas para o ID\nconst todasAvaliacoes = $input.all().map(i => i.json);\n\n// A avaliação atual é a última enviada\nconst atual = todasAvaliacoes[todasAvaliacoes.length - 1];\n\n// Identifica se há avaliação anterior\nconst anterior = todasAvaliacoes.length > 1 ? todasAvaliacoes[todasAvaliacoes.length - 2] : null;\n\n// Função auxiliar para calcular Petroski 4 Dobras\nfunction calcularMetricas(item) {\n  if (!item) return null;\n  const peso = Number(item['Peso (kg)'] || item['Body mass'] || 0);\n  let altura = Number(item['Altura (m)'] || item['Height'] || 1);\n  if (altura > 3) altura = altura / 100;\n\n  const idade = Number(item['Idade'] || item['Age'] || 0);\n  const sexo = String(item['Sexo'] || item['Genêro'] || 'Masculino').toLowerCase();\n  \n  const triceps = Number(item['Dobra Tríceps (mm)'] || item['Tricipital'] || 0);\n  const subesc = Number(item['Dobra Subescapular (mm)'] || item['Subscapularis'] || 0);\n  const supra = Number(item['Dobra Suprailíaca (mm)'] || item['Suprailiaca'] || 0);\n  const abdom = Number(item['Dobra Abdominal (mm)'] || item['Abdomen'] || 0);\n  \n  const soma4 = triceps + subesc + supra + abdom;\n  let dc = 0;\n  if (sexo.includes('masc') || sexo === 'male') {\n    dc = 1.10726863 - (0.00081201 * soma4) + (0.00000212 * Math.pow(soma4, 2)) - (0.00041761 * idade);\n  } else {\n    dc = 1.1954713 - (0.0751350 * Math.log10(soma4)) - (0.00041072 * idade);\n  }\n\n  const percGordura = Number((((4.95 / dc) - 4.50) * 100).toFixed(1));\n  const massaGorda = Number((peso * (percGordura / 100)).toFixed(2));\n  const massaMagra = Number((peso - massaGorda).toFixed(2));\n  const imc = (peso / Math.pow(altura, 2)).toFixed(2);\n  const cintura = Number(item['Cintura (cm)'] || item['Waist'] || 0);\n  const quadril = Number(item['Quadril (cm)'] || item['Hip'] || 0);\n  const rcq = quadril > 0 ? (cintura / quadril).toFixed(2) : 0;\n\n  return {\n    data: item['Data da Avaliação'] || item['Carimbo de data/hora'] || 'Atual',\n    peso, cintura, quadril, percGordura, massaMagra, massaGorda, imc, rcq,\n    triceps, subesc, supra, abdom\n  };\n}\n\nconst resAtual = calcularMetricas(atual);\nconst resAnterior = calcularMetricas(anterior);\n\n// Função para formatar variação (Ex: -2.3 kg, +1.1 %)\nfunction diff(atualVal, antVal, unidade = '') {\n  if (!antVal) return '-';\n  const delta = Number((atualVal - antVal).toFixed(2));\n  const sinal = delta > 0 ? '+' : '';\n  const cor = delta < 0 ? '#2e7d32' : (delta > 0 ? '#c62828' : '#666');\n  return `<span style=\"color:${cor}; font-size:11px;\">(${sinal}${delta} ${unidade})</span>`;\n}\n\n// Montagem do HTML com tabela comparativa\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; background: #fff; margin: 0; padding: 20px; color: #333; }\n    .container { max-width: 680px; margin: auto; border: 1px solid #ddd; border-radius: 8px; padding: 20px; }\n    .header { border-bottom: 3px solid #2e7d32; padding-bottom: 10px; margin-bottom: 20px; }\n    table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 13px; }\n    th, td { border: 1px solid #e0e0e0; padding: 8px 12px; text-align: center; }\n    th { background: #f0f4f1; color: #2e7d32; }\n    .destaque { font-weight: bold; background: #fafafa; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h2 style=\"margin:0; color:#1b5e20;\">Evolução Antropométrica</h2>\n      <p style=\"margin:5px 0 0 0; font-size:13px; color:#555;\">\n        <strong>Aluno:</strong> ${atual['Nome do Aluno'] || atual[\"What's your name?\"] || 'Aluno'} | <strong>ID:</strong> ${atual['ID do Aluno']}\n      </p>\n    </div>\n\n    <p style=\"font-size:13px;\">\n      ${resAnterior ? `Comparativo entre a avaliação de <b>${resAnterior.data}</b> e a atual (<b>${resAtual.data}</b>):` : 'Esta é a primeira avaliação cadastrada para este ID.'}\n    </p>\n\n    <table>\n      <thead>\n        <tr>\n          <th>Indicador</th>\n          ${resAnterior ? `<th>Anterior (${resAnterior.data})</th>` : ''}\n          <th>Atual (${resAtual.data})</th>\n          ${resAnterior ? '<th>Progresso</th>' : ''}\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"destaque\">Peso Corporal</td>\n          ${resAnterior ? `<td>${resAnterior.peso} kg</td>` : ''}\n          <td><b>${resAtual.peso} kg</b></td>\n          ${resAnterior ? `<td>${diff(resAtual.peso, resAnterior.peso, 'kg')}</td>` : ''}\n        </tr>\n        <tr>\n          <td class=\"destaque\">% de Gordura</td>\n          ${resAnterior ? `<td>${resAnterior.percGordura}%</td>` : ''}\n          <td><b>${resAtual.percGordura}%</b></td>\n          ${resAnterior ? `<td>${diff(resAtual.percGordura, resAnterior.percGordura, '%')}</td>` : ''}\n        </tr>\n        <tr>\n          <td class=\"destaque\">Massa Magra</td>\n          ${resAnterior ? `<td>${resAnterior.massaMagra} kg</td>` : ''}\n          <td><b>${resAtual.massaMagra} kg</b></td>\n          ${resAnterior ? `<td>${diff(resAtual.massaMagra, resAnterior.massaMagra, 'kg')}</td>` : ''}\n        </tr>\n        <tr>\n          <td class=\"destaque\">Massa Gorda</td>\n          ${resAnterior ? `<td>${resAnterior.massaGorda} kg</td>` : ''}\n          <td><b>${resAtual.massaGorda} kg</b></td>\n          ${resAnterior ? `<td>${diff(resAtual.massaGorda, resAnterior.massaGorda, 'kg')}</td>` : ''}\n        </tr>\n        <tr>\n          <td class=\"destaque\">Cintura</td>\n          ${resAnterior ? `<td>${resAnterior.cintura} cm</td>` : ''}\n          <td><b>${resAtual.cintura} cm</b></td>\n          ${resAnterior ? `<td>${diff(resAtual.cintura, resAnterior.cintura, 'cm')}</td>` : ''}\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</body>\n</html>`;\n\nconst binaryFile = await this.helpers.prepareBinaryData(\n  Buffer.from(html, 'utf-8'),\n  'index.html',\n  'text/html'\n);\n\nreturn [\n  {\n    json: {\n      ...atual,\n      resAtual,\n      resAnterior,\n      temHistorico: !!resAnterior,\n      html_content: html\n    },\n    binary: {\n      data: binaryFile\n    }\n  }\n];"
      },
